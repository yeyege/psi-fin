# ===== PSI-FIN 环境变量示例 =====
# Docker 部署：复制为仓库根 .env 后 `docker compose up -d` 生效；不建 .env 时使用右侧默认值。
# 本地开发（uvicorn / pytest）：复制为 backend-python/.env，把主机名 compose 服务名换成 localhost。
# 该文件按仓库规则不入库（.gitignore 的 `.env` 匹配任意层级），只保存本机连接串。

# ---- PostgreSQL 16：主库（openspec D17）----
# 起法（仓库根目录）：docker compose up -d postgres
POSTGRES_USER=psi_fin
POSTGRES_PASSWORD=psi_fin
POSTGRES_DB=psi_fin
# 本地开发用这条（compose 主机端口已发布到 5432）：
# DATABASE_URL=postgresql+psycopg2://psi_fin:psi_fin@localhost:5432/psi_fin
# pytest 不用另配：tests/conftest.py 会把上面的库名派生成 psi_fin_test，
# 并拒绝在非 *_test 结尾的库上 TRUNCATE。只有要指向别的测试库时才显式设 TEST_DATABASE_URL：
# TEST_DATABASE_URL=postgresql+psycopg2://psi_fin:psi_fin@localhost:5432/psi_fin_test

# ---- MySQL 8.0：兼容部署选项，只在 --profile mysql 时启用 ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=psi_fin
MYSQL_USER=psi_fin
MYSQL_PASSWORD=psi_fin
# DATABASE_URL=mysql+pymysql://psi_fin:psi_fin@localhost:3306/psi_fin?charset=utf8mb4

# ---- 后端 CORS 允许来源（逗号分隔）；不设置时默认 "*"（本地经 vite/nginx 同源代理）----
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
