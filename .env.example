# ===== PSI-FIN Docker 环境变量示例 =====
# 复制为 .env 后执行 docker compose up -d 生效；不建 .env 时使用右侧默认值。
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=psi_fin
MYSQL_USER=psi_fin
MYSQL_PASSWORD=psi_fin
# 后端容器内数据库连接由 compose 自动注入，本地开发如需切换数据库：
# DATABASE_URL=mysql+pymysql://psi_fin:psi_fin@localhost:3306/psi_fin?charset=utf8mb4
